{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env*", "pnpm-lock.yaml", "tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "VITE_*",
        "PUBLIC_*",
        "CLERK_PUBLISHABLE_KEY",
        "NITRO_PRESET",
        "NODE_ENV",
        "VERCEL",
        "VERCEL_ENV",
        "GITHUB_ACTIONS"
      ],
      "outputs": [".output/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
